{
  "name": "stick-war-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "lint": "eslint src tests scripts/*.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:web": "npm run check && vite build && node scripts/check-budget.mjs",
    "serve:web": "vite preview --host 127.0.0.1",
    "assets:build": "node scripts/build-assets.mjs",
    "assets:author": "node scripts/build-assets.mjs --author",
    "assets:animate": "node scripts/build-assets.mjs --animate",
    "assets:check": "node scripts/check-assets.mjs",
    "format:check": "prettier --check src tests config index.html"
  },
  "dependencies": {
    "three": "0.186.0",
    "@dimforge/rapier3d-compat": "0.20.0",
    "lit": "3.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@types/three": "0.186.0",
    "@types/node": "22.20.3",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.6",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.2.0"
  }
}
